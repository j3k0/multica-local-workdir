[Unit]
Description=Hindsight: refresh stale mental models (at most daily per model; FOV-2242)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
TimeoutStartSec=600
# omp still seeds new banks with refresh_after_consolidation=true: switch those off first.
# "-": a failure here is logged but doesn't block the refresh below.
# To roll back to per-consolidation refresh, delete this line and daemon-reload FIRST,
# or the next hourly run switches the flag back off.
ExecStartPre=-/opt/projects/tools/multica-local-workdir/hindsight/refresh-off.sh --apply
ExecStart=/opt/projects/tools/multica-local-workdir/hindsight/daily-refresh.sh --apply
