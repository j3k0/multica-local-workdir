#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(pwd)"

# Source optional .env file (e.g. OPENCODE_BIN overrides)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

working_dir=""

# Extract --working-directory <path> from anywhere in the argument list
new_args=()
skip_next=false
for arg in "$@"; do
  if [ "$skip_next" = "true" ]; then
    working_dir="$arg"
    skip_next=false
    continue
  fi
  if [ "$arg" = "--working-directory" ]; then
    skip_next=true
    continue
  fi
  new_args+=("$arg")
done
set -- "${new_args[@]}"

# Fall back to the env var when the flag isn't provided
if [ -z "$working_dir" ] && [ ! -z "$LOCAL_WORKING_PATH" ]; then
  working_dir="$LOCAL_WORKING_PATH"
fi

if [ ! -z "$working_dir" ] && [ -d "$working_dir" ]; then
  cd "$working_dir"

  # opencode honors --dir over CWD. The daemon passes --dir <workspace>,
  # so rewrite its value to point at the project, otherwise the cd above
  # is ignored and project-scoped config doesn't load.
  rewritten_args=()
  rewrite_next=false
  saw_dir=false
  for arg in "$@"; do
    if [ "$rewrite_next" = "true" ]; then
      rewritten_args+=("$working_dir")
      rewrite_next=false
      continue
    fi
    if [ "$arg" = "--dir" ]; then
      saw_dir=true
      rewrite_next=true
      rewritten_args+=("$arg")
      continue
    fi
    rewritten_args+=("$arg")
  done
  if [ "$saw_dir" = "false" ]; then
    rewritten_args=("--dir" "$working_dir" "${rewritten_args[@]}")
  fi
  set -- "${rewritten_args[@]}"

  # Pull in the workspace's AGENTS.md (multica agent instructions) via a
  # custom OPENCODE_CONFIG that uses {env:EXTRA_INSTRUCTIONS_PATH} interpolation
  # in its "instructions" array.
  if [ -f "$WORKSPACE_DIR/AGENTS.md" ]; then
    export EXTRA_INSTRUCTIONS_PATH="$WORKSPACE_DIR/AGENTS.md"
    export OPENCODE_CONFIG="$SCRIPT_DIR/opencode-config.json"
  fi
fi

exec "${OPENCODE_BIN:-opencode}" "$@"
