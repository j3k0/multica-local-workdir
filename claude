#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(pwd)"

# Preserve caller-provided LWD_* across .env sourcing — .env is for defaults,
# values already in the environment (e.g. set per-agent in multica) win.
_lwd_provider_override="$LWD_PROVIDER"
_lwd_model_override="$LWD_MODEL"
_lwd_allow_mcp_override="$LWD_ALLOW_MCP"

# Source optional .env file (e.g. CLAUDE_BIN overrides)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

[ -n "$_lwd_provider_override" ] && LWD_PROVIDER="$_lwd_provider_override"
[ -n "$_lwd_model_override" ] && LWD_MODEL="$_lwd_model_override"
[ -n "$_lwd_allow_mcp_override" ] && LWD_ALLOW_MCP="$_lwd_allow_mcp_override"
unset _lwd_provider_override _lwd_model_override _lwd_allow_mcp_override

# Provider selection: LWD_PROVIDER=<name> sources claude-providers/<name>.sh,
# which is expected to export ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN /
# model defaults to redirect claude at a non-Anthropic backend. Provider
# files may honor LWD_MODEL to pick a specific model.
# Fail loud on a missing file rather than silently falling back to Anthropic.
if [ -n "$LWD_PROVIDER" ]; then
  provider_file="$SCRIPT_DIR/claude-providers/$LWD_PROVIDER.sh"
  if [ ! -f "$provider_file" ]; then
    echo "claude wrapper: LWD_PROVIDER='$LWD_PROVIDER' not found at $provider_file" >&2
    exit 1
  fi
  . "$provider_file"
fi

working_dir=""

# Extract --working-directory <path> from anywhere in the argument list
new_args=()
skip_next=false
for arg in "$@"; do
  if [ "$skip_next" = "true" ]; then
    working_dir="$arg"
    skip_next=false
    continue
  fi
  if [ "$arg" = "--working-directory" ]; then
    skip_next=true
    continue
  fi
  # Drop multica's --strict-mcp-config when LWD_ALLOW_MCP=1 so the project's
  # own MCP servers (.claude/settings.json, user config) load. multica injects
  # this flag to sandbox SaaS agents; on a self-hosted setup the operator owns
  # the project and the sandboxing isn't wanted.
  if [ "$arg" = "--strict-mcp-config" ] && [ "$LWD_ALLOW_MCP" = "1" ]; then
    continue
  fi
  new_args+=("$arg")
done
set -- "${new_args[@]}"

# Fall back to the env var when the flag isn't provided
if [ -z "$working_dir" ] && [ ! -z "$LOCAL_WORKING_PATH" ]; then
  working_dir="$LOCAL_WORKING_PATH"
fi

if [ ! -z "$working_dir" ] && [ -d "$working_dir" ]; then
  cd "$working_dir"
  # Pull in the workspace's CLAUDE.md (multica agent instructions) by
  # appending it to the system prompt. --add-dir does NOT auto-discover
  # CLAUDE.md from added dirs (verified empirically), so use this instead.
  if [ -f "$WORKSPACE_DIR/CLAUDE.md" ]; then
    set -- --append-system-prompt "$(cat "$WORKSPACE_DIR/CLAUDE.md")" "$@"
  fi
fi

exec "${CLAUDE_BIN:-claude}" "$@"
