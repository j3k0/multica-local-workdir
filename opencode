#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(pwd)"

# Agent runs resolve `multica` through this repo's shim (bin/multica) and carry
# a marker saying so; see bin/multica. multica-daemon and JC's shell get neither.
_lwd_path_backup="$PATH"
# FOV-2098 canary switch: LWD_GATE_AGENTS (ambient > .env, comma list) shims
# only the named agents; unset/empty shims everyone. Unknown agent name + a set
# list = no shim (fail-open; silent like the rest of this wrapper).
_lwd_gate_agents="${LWD_GATE_AGENTS:-}"
if [ -z "$_lwd_gate_agents" ] && [ -f "$SCRIPT_DIR/.env" ]; then
  _lwd_gate_agents="$(. "$SCRIPT_DIR/.env" >/dev/null 2>&1; printf '%s' "${LWD_GATE_AGENTS:-}")"
fi
_lwd_shim_on=true
if [ -n "$_lwd_gate_agents" ]; then
  _lwd_shim_on=false
  if [ -n "${MULTICA_AGENT_NAME:-}" ]; then
    IFS=, read -r -a _lwd_list <<< "$_lwd_gate_agents"
    for _a in "${_lwd_list[@]}"; do
      _a="${_a#"${_a%%[![:space:]]*}"}"; _a="${_a%"${_a##*[![:space:]]}"}"
      [ "$(printf '%s' "$_a" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "${MULTICA_AGENT_NAME:-}" | tr '[:upper:]' '[:lower:]')" ] && _lwd_shim_on=true
    done
  fi
fi
_lwd_gate_agents_resolved="$_lwd_gate_agents"
unset _lwd_gate_agents _a _lwd_list
if [ "$_lwd_shim_on" = true ]; then
  PATH="$SCRIPT_DIR/bin:$PATH"
  export LWD_AGENT_RUN=1
else
  unset LWD_AGENT_RUN
fi

# Source optional .env file (e.g. OPENCODE_BIN overrides)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

# .env must not be able to switch the agent-run PATH/marker off silently —
# re-assert both after sourcing (no log infra in this wrapper; silent by design).
# The wrapper's canary decision and the agent's shim must read the same list: .env
# (sourced with set -a) would otherwise overwrite an ambient value.
[ -n "$_lwd_gate_agents_resolved" ] && export LWD_GATE_AGENTS="$_lwd_gate_agents_resolved"
[ "$_lwd_shim_on" = true ] && {
  PATH="$SCRIPT_DIR/bin:${_lwd_path_backup:-$PATH}"
  export LWD_AGENT_RUN=1
}

working_dir=""

# Extract --working-directory <path> from anywhere in the argument list
new_args=()
skip_next=false
for arg in "$@"; do
  if [ "$skip_next" = "true" ]; then
    working_dir="$arg"
    skip_next=false
    continue
  fi
  if [ "$arg" = "--working-directory" ]; then
    skip_next=true
    continue
  fi
  new_args+=("$arg")
done
set -- "${new_args[@]}"

# Fall back to the env var when the flag isn't provided
if [ -z "$working_dir" ] && [ ! -z "$LOCAL_WORKING_PATH" ]; then
  working_dir="$LOCAL_WORKING_PATH"
fi

if [ ! -z "$working_dir" ] && [ -d "$working_dir" ]; then
  cd "$working_dir"

  # opencode honors --dir over CWD. The daemon passes --dir <workspace>,
  # so rewrite its value to point at the project, otherwise the cd above
  # is ignored and project-scoped config doesn't load.
  rewritten_args=()
  rewrite_next=false
  saw_dir=false
  for arg in "$@"; do
    if [ "$rewrite_next" = "true" ]; then
      rewritten_args+=("$working_dir")
      rewrite_next=false
      continue
    fi
    if [ "$arg" = "--dir" ]; then
      saw_dir=true
      rewrite_next=true
      rewritten_args+=("$arg")
      continue
    fi
    rewritten_args+=("$arg")
  done
  if [ "$saw_dir" = "false" ]; then
    rewritten_args=("--dir" "$working_dir" "${rewritten_args[@]}")
  fi
  set -- "${rewritten_args[@]}"

  # Pull in the workspace's AGENTS.md (multica agent instructions) via a
  # custom OPENCODE_CONFIG that uses {env:EXTRA_INSTRUCTIONS_PATH} interpolation
  # in its "instructions" array.
  if [ -f "$WORKSPACE_DIR/AGENTS.md" ]; then
    export EXTRA_INSTRUCTIONS_PATH="$WORKSPACE_DIR/AGENTS.md"
    export OPENCODE_CONFIG="$SCRIPT_DIR/opencode-config.json"
  fi
fi

exec "${OPENCODE_BIN:-opencode}" "$@"
