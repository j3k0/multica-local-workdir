[Unit]
Description=Alert when Intern's Hindsight bank calls a hosted model (FOV-2962)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
TimeoutStartSec=180
Environment=ROUTE_BANK=agent-intern
Environment=ALERT_KEY=intern-hindsight-route
ExecStart=/opt/projects/tools/multica-local-workdir/hindsight/ema-route-check.sh
