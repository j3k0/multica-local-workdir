#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source optional .env (e.g. MULTICA_SERVER_URL, MULTICA_BIN)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

# Gate knobs must not be baked into the daemon's environment: every agent run
# would inherit them as "ambient" values that beat the live .env, so an edited
# canary list stayed dead until the next restart (FOV-2098, 2026-10-22..27).
# Per-agent values set in multica still arrive as ambient env.
unset LWD_GATE_AGENTS LWD_GATE_ENFORCE_AGENTS LWD_GATE_MODE

export MULTICA_CLAUDE_PATH="$SCRIPT_DIR/claude"
export MULTICA_OPENCODE_PATH="$SCRIPT_DIR/opencode"
export MULTICA_PI_PATH="$SCRIPT_DIR/pi"
export MULTICA_OMP_PATH="$SCRIPT_DIR/omp"

exec "${MULTICA_BIN:-multica}" daemon "$@"
