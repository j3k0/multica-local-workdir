#!/bin/bash
set -e

# bin/multica — shim in front of the real multica CLI, for AGENT runs only
# (step 2 of 8 in FOV-2094).

# The agent wrappers (claude, pi/omp, opencode) prepend this directory to PATH
# and export LWD_AGENT_RUN=1, so a bare `multica` typed by an agent lands here.
# multica-daemon does NOT get this PATH, and neither does JC's shell — that is
# what the marker disambiguates: LWD_AGENT_RUN=1 says "an agent is running",
# and only agent runs get gated behaviour (gates themselves are step 3). The
# marker is agent-settable inside a run, so this shim is a mistake-catcher and
# observability layer, NOT a security boundary (see the FOV-2096 spike: agents
# hold a live MULTICA_TOKEN).

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
LOG_FILE="$REPO_DIR/logs/multica-shim.log"

# ---------------------------------------------------------------- resolve ---
# Real binary: ambient MULTICA_BIN, then MULTICA_BIN from .env (read in a
# subshell so nothing else in .env — secrets — leaks into the CLI's env), then
# PATH, skipping this directory (a bare PATH lookup here would find this shim
# — recursion). A set-but-unusable MULTICA_BIN falls through to PATH with a
# warning rather than killing every multica call on the host; a totally
# missing binary fails loud.
real_bin="${MULTICA_BIN:-}"
if [ -z "$real_bin" ] && [ -f "$REPO_DIR/.env" ]; then
  real_bin="$(. "$REPO_DIR/.env" >/dev/null 2>&1; printf '%s' "${MULTICA_BIN:-}")"
fi
if [ -n "$real_bin" ]; then
  if [ ! -f "$real_bin" ] || [ ! -x "$real_bin" ] || [ -d "$real_bin" ]; then
    echo "bin/multica: warning: MULTICA_BIN ($real_bin) is not an executable file; falling back to PATH (fix .env)" >&2
    real_bin=""
  fi
fi
if [ -z "$real_bin" ]; then
  IFS=: read -r -a _path_dirs <<< "$PATH"
  for _d in "${_path_dirs[@]}"; do
    [ -n "$_d" ] && [ -d "$_d" ] || continue
    [ "$(cd "$_d" 2>/dev/null && pwd -P)" = "$SCRIPT_DIR" ] && continue
    if [ -f "$_d/multica" ] && [ -x "$_d/multica" ]; then
      real_bin="$_d/multica"
      break
    fi
  done
fi
if [ -z "$real_bin" ]; then
  echo "bin/multica: real multica CLI not found (set MULTICA_BIN in $REPO_DIR/.env)" >&2
  exit 127
fi
# Never exec ourselves (MULTICA_BIN pointing back here, or a hardlink of us).
# -ef compares via inode, so it needs no readlink -f (portability: BSD/macOS).
if [ "$real_bin" -ef "${BASH_SOURCE[0]}" ]; then
  echo "bin/multica: MULTICA_BIN ($real_bin) points at this shim; set it to the real multica CLI" >&2
  exit 127
fi

# ------------------------------------------------------------ gate frame ---
# Gather the command tokens: all arguments that do not start with `-`, except
# a value that immediately follows a global value-taking flag. This survives
# `multica --workspace-id <id> issue status …`. The list is the four flags the
# real CLI accepts BEFORE a subcommand (verified by brute force in FOV-2096,
# CLI 0.6.3: --profile/--server-url/--workspace-id/--output) — root --help does
# not advertise them all, so the probe test in test/multica-shim.test.sh checks
# the set after any CLI upgrade. Over-matching costs nothing: a gate that reads
# more, never less.
_tokens=()
_skip_value=false
for _arg in "$@"; do
  if [ "$_skip_value" = "true" ]; then
    _skip_value=false
    continue
  fi
  case "$_arg" in
    --workspace-id|--profile|--server-url|--output) _skip_value=true ;;
    -*) ;;
    *) _tokens+=("$_arg") ;;
  esac
done
if [ "${LWD_AGENT_RUN:-}" = "1" ] && [ "${#_tokens[@]}" -gt 0 ]; then
  cmd="${_tokens[0]}"
  sub="${_tokens[1]:-}"
  sub2="${_tokens[2]:-}"
  gated=false
  # Mutating issue commands only; read commands (issue get/list, …) pass free.
  case "$cmd" in
    issue)
      case "$sub" in
        status|update|assign|create) gated=true ;;
        comment) [ "$sub2" = "add" ] && gated=true ;;
      esac
      ;;
  esac
  if [ "$gated" = "true" ]; then
    # Best-effort log for step 3: %q-quoted argv (immune to timestamp/injection
    # games), capped at 2000 chars per line so comment payloads can't bloat the
    # file. A missing log dir or failed append never breaks a run.
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    {
      printf '%s|agent|' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '%q ' "$@"
    } | cut -c 1-2000 >> "$LOG_FILE" 2>/dev/null || true
    # Step 3 (FOV-2097): hand the command to the gate. The gate carries the
    # real binary and log path via env so argv stays untouched; it execs the
    # real CLI itself (possibly with adjusted argv for the new handoff flags).
    # Fail-open: no gate script or python3 -> log above + passthrough.
    if [ -f "$SCRIPT_DIR/multica-gate.py" ] && command -v python3 >/dev/null 2>&1; then
      # FOV-2098 canary switches, resolved ambient > .env (comma lists, compared
      # against MULTICA_AGENT_NAME case-insensitively):
      #   LWD_GATE_AGENTS         shim only these agents; unset/empty = everyone —
      #                           the one-line canary/rollback switch for the PATH
      #                           injection itself
      #   LWD_GATE_ENFORCE_AGENTS these agents run the gate in enforce (refuse)
      #                           mode; everyone else stays in warn — lets refuse
      #                           mode be scoped to the canaries after the warning
      #                           week without touching per-agent env
      _gate_agents="${LWD_GATE_AGENTS:-}"
      if [ -z "$_gate_agents" ] && [ -f "$REPO_DIR/.env" ]; then
        _gate_agents="$(. "$REPO_DIR/.env" >/dev/null 2>&1; printf '%s' "${LWD_GATE_AGENTS:-}")"
      fi
      if [ -n "$_gate_agents" ]; then
        _in_list=false
        for _n in ${_gate_agents//,/ }; do
          [ "$(printf '%s' "$_n" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "${MULTICA_AGENT_NAME:-}" | tr '[:upper:]' '[:lower:]')" ] && _in_list=true
        done
        if [ "$_in_list" != "true" ]; then
          printf 'bin/multica: %s is not in LWD_GATE_AGENTS; no gate for this run\n' "${MULTICA_AGENT_NAME:-<unknown agent>}" >&2 || true
          exec "$real_bin" "$@"
        fi
      fi
      _gate_mode="${LWD_GATE_MODE:-warn}"
      _enforce_agents="${LWD_GATE_ENFORCE_AGENTS:-}"
      if [ -z "$_enforce_agents" ] && [ -f "$REPO_DIR/.env" ]; then
        _enforce_agents="$(. "$REPO_DIR/.env" >/dev/null 2>&1; printf '%s' "${LWD_GATE_ENFORCE_AGENTS:-}")"
      fi
      if [ -n "$_enforce_agents" ]; then
        for _n in ${_enforce_agents//,/ }; do
          if [ "$(printf '%s' "$_n" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "${MULTICA_AGENT_NAME:-}" | tr '[:upper:]' '[:lower:]')" ]; then
            _gate_mode=enforce
            break
          fi
        done
      fi
      unset _gate_agents _enforce_agents _n _in_list
      MULTICA_REAL_BIN="$real_bin" \
      LWD_GATE_LOG="$LOG_FILE" \
      LWD_GATE_MODE="$_gate_mode" \
        exec python3 "$SCRIPT_DIR/multica-gate.py" "$@"
    fi
    printf 'bin/multica: warning: gate unavailable (multica-gate.py/python3 missing); passing through\n' >&2 || true
  fi
fi

# ------------------------------------------------------------ passthrough ---
# Everything not handed to the gate above is exec'd intact: argv, stdin,
# stdout, stderr and exit code are the real CLI's.
exec "$real_bin" "$@"
