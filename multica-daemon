#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source optional .env (e.g. MULTICA_SERVER_URL, MULTICA_BIN)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

export MULTICA_CLAUDE_PATH="$SCRIPT_DIR/claude"
export MULTICA_OPENCODE_PATH="$SCRIPT_DIR/opencode"

exec "${MULTICA_BIN:-multica}" daemon "$@"
