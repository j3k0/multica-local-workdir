#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(pwd)"

# Log each invocation to ${LOG_DIR:-$SCRIPT_DIR/logs}/pi.log.
# Best-effort: never let logging failures abort the wrapper.
_log_dir="${LOG_DIR:-$SCRIPT_DIR/logs}"
mkdir -p "$_log_dir" 2>/dev/null || true
_log_pi() {
  printf '%s pid=%s cwd=%s bin=%s args:' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$$" "$WORKSPACE_DIR" "${PI_BIN:-pi}" >> "$_log_dir/pi.log" 2>/dev/null || true
  printf ' %q' "$@" >> "$_log_dir/pi.log" 2>/dev/null || true
  printf '\n' >> "$_log_dir/pi.log" 2>/dev/null || true
}

# Preserve a caller-provided LWD_PI_VARIANT across .env sourcing — .env holds
# the default variant, a value already in the environment (set per-agent in
# multica) wins. Same idiom as the claude wrapper's LWD_* overrides.
_lwd_pi_variant_override="$LWD_PI_VARIANT"

# Source optional .env file (e.g. OMP_BIN / PI_BIN / LWD_PI_VARIANT)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

# Re-apply the ambient variant (per-agent) over the .env default.
[ -n "$_lwd_pi_variant_override" ] && LWD_PI_VARIANT="$_lwd_pi_variant_override"

# Select the pi binary from LWD_PI_VARIANT (default: pi = vanilla pi).
# omp → OMP_BIN (oh-my-pi), pi → PI_BIN. The bin paths live in .env so the
# install locations are declared once; agents only carry the lightweight variant
# knob (reinstalling omp elsewhere → touch .env, not every agent). Unknown
# variant fails loud, matching LWD_PROVIDER's loud failure on an operator typo.
case "${LWD_PI_VARIANT:-pi}" in
  omp) PI_BIN="${OMP_BIN:-omp}" ;;
  pi)  PI_BIN="${PI_BIN:-pi}" ;;
  *)   echo "pi wrapper: LWD_PI_VARIANT='$LWD_PI_VARIANT' invalid (expected: pi, omp)" >&2; exit 1 ;;
esac

_log_pi "$@"

working_dir=""

# Extract --working-directory <path> from anywhere in the argument list
new_args=()
skip_next=false
for arg in "$@"; do
  if [ "$skip_next" = "true" ]; then
    working_dir="$arg"
    skip_next=false
    continue
  fi
  if [ "$arg" = "--working-directory" ]; then
    skip_next=true
    continue
  fi
  new_args+=("$arg")
done
set -- "${new_args[@]}"

# Fall back to the env var when the flag isn't provided
if [ -z "$working_dir" ] && [ ! -z "$LOCAL_WORKING_PATH" ]; then
  working_dir="$LOCAL_WORKING_PATH"
fi

if [ ! -z "$working_dir" ] && [ -d "$working_dir" ]; then
  cd "$working_dir"
  # Pull in the workspace's CLAUDE.md / AGENTS.md (multica agent instructions)
  # by appending them to the system prompt. pi auto-discovers context files from
  # CWD (the project), but the workspace's files aren't there after the cd.
  # pi's --append-system-prompt auto-detects file paths and reads the contents,
  # so we pass the path directly — no shell expansion needed.
  if [ -f "$WORKSPACE_DIR/CLAUDE.md" ]; then
    set -- --append-system-prompt "$WORKSPACE_DIR/CLAUDE.md" "$@"
  fi
  if [ -f "$WORKSPACE_DIR/AGENTS.md" ]; then
    set -- --append-system-prompt "$WORKSPACE_DIR/AGENTS.md" "$@"
  fi
fi

exec "${PI_BIN:-pi}" "$@"