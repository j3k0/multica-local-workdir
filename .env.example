# multica-local-workdir configuration overrides.
# Copy to `.env` (in this same directory) and uncomment what you need.

# Override the claude binary (default: `claude` on PATH)
# CLAUDE_BIN=/path/to/claude

# Override the opencode binary (default: `opencode` on PATH)
# OPENCODE_BIN=/path/to/opencode

# Override the pi binary (default: `pi` on PATH)
# PI_BIN=/path/to/pi

# Override the multica binary (default: `multica` on PATH).
# Only consumed by the `multica-daemon` wrapper.
# MULTICA_BIN=/path/to/multica

# WebSocket URL of the multica server.
# Only consumed by the `multica-daemon` wrapper.
# MULTICA_SERVER_URL=ws://multica.example.com/ws

# Route the `claude` wrapper through a non-Anthropic backend. The value
# must match a file in `claude-providers/<name>.sh`. Optionally override
# the model that provider uses (interpretation is provider-specific).
# For richer variants, copy an existing provider file to a new name.
# LWD_PROVIDER=deepseek
# LWD_MODEL=deepseek-v4-pro[1m]

# API key for the `deepseek` provider. Required only when LWD_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=sk-...

# API key for the `openrouter` provider. Required only when LWD_PROVIDER=openrouter.
# OPENROUTER_API_KEY=sk-or-...
# Default model for the openrouter provider (overridden by LWD_MODEL if set).
# LWD_OPENROUTER_MODEL=qwen/qwen3.7-max

# The `opencode-go` provider routes claude through OpenCode Go's open-weight
# models. OpenCode Go has no Anthropic-compatible endpoint, so it needs the
# `oc-go-cc` translating proxy running separately (NOT started by these wrappers):
#   OC_GO_CC_API_KEY=sk-opencode-... oc-go-cc serve   # listens on 127.0.0.1:3456
# Then set LWD_PROVIDER=opencode-go. The subscription key lives in the proxy's
# env above, not here. Override the proxy URL only if you ran it on another port:
# OPENCODE_GO_PROXY_URL=http://127.0.0.1:3456
# Tier→model mapping (default/thinking/long-context/background) is configured in
# oc-go-cc itself, not via LWD_MODEL.

# Force a `--fallback-model` on the `claude` wrapper (skipped if the caller
# already passes `--fallback-model`). claude accepts a comma-separated list and
# tries each in order. Handy when switching providers whose models reject some
# request parameters (thinking, …) — claude retries on the fallback. The model
# strings are passed verbatim to whatever backend claude points at, so they can
# be provider-specific (OpenRouter/DeepSeek/etc.), not just Anthropic IDs.
# Priority: ambient env > provider file > .env.
# LWD_FALLBACK_MODEL=glm-5.1:cloud,claude-opus-4-8,claude-sonnet-4-6,deepseek/deepseek-v4-pro

# Strip `--strict-mcp-config` from claude's argv so the project's MCP servers
# (`.claude/settings.json`, user config) load. multica injects that flag to
# sandbox SaaS agents; on a self-hosted setup you usually want it gone.
# Only opt in if you trust every MCP server the project can reach.
# LWD_ALLOW_MCP=1
