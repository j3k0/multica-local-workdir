# multica-local-workdir configuration overrides.
# Copy to `.env` (in this same directory) and uncomment what you need.

# Override the claude binary (default: `claude` on PATH)
# CLAUDE_BIN=/path/to/claude

# Override the opencode binary (default: `opencode` on PATH)
# OPENCODE_BIN=/path/to/opencode

# Override the multica binary (default: `multica` on PATH).
# Only consumed by the `multica-daemon` wrapper.
# MULTICA_BIN=/path/to/multica

# WebSocket URL of the multica server.
# Only consumed by the `multica-daemon` wrapper.
# MULTICA_SERVER_URL=ws://multica.example.com/ws

# Route the `claude` wrapper through a non-Anthropic backend. The value
# must match a file in `claude-providers/<name>.sh`. Optionally override
# the model that provider uses (interpretation is provider-specific).
# For richer variants, copy an existing provider file to a new name.
# LWD_PROVIDER=deepseek
# LWD_MODEL=deepseek-v4-pro[1m]

# API key for the `deepseek` provider. Required only when LWD_PROVIDER=deepseek.
# DEEPSEEK_API_KEY=sk-...
