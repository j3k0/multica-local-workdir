#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(pwd)"

# Log each invocation to ${LOG_DIR:-$SCRIPT_DIR/logs}/claude.log.
# Best-effort: never let logging failures abort the wrapper.
_log_dir="${LOG_DIR:-$SCRIPT_DIR/logs}"
mkdir -p "$_log_dir" 2>/dev/null || true
printf '%s pid=%s cwd=%s args:' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$$" "$WORKSPACE_DIR" >> "$_log_dir/claude.log" 2>/dev/null || true
printf ' %q' "$@" >> "$_log_dir/claude.log" 2>/dev/null || true
printf '\n' >> "$_log_dir/claude.log" 2>/dev/null || true

# Preserve caller-provided LWD_* across .env sourcing — .env is for defaults,
# values already in the environment (e.g. set per-agent in multica) win.
_lwd_provider_override="$LWD_PROVIDER"
_lwd_claude_provider_override="$LWD_CLAUDE_PROVIDER"
_lwd_model_override="$LWD_MODEL"
_lwd_allow_mcp_override="$LWD_ALLOW_MCP"
_lwd_fallback_model_override="$LWD_FALLBACK_MODEL"
_lwd_effort_override="$LWD_EFFORT"

# Source optional .env file (e.g. CLAUDE_BIN overrides)
if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  . "$SCRIPT_DIR/.env"
  set +a
fi

# --- Per-task settings (highest priority) -----------------------------------
# multica writes the task's `multica issue get <id>` command into the workspace
# CLAUDE.md. We read the issue and apply settings from its *labels*: names of
# the form `key: value` with keys effort/model/provider/path let a single task
# pin its own settings, outranking per-agent (ambient env) and global (.env)
# values. Labels are the per-task channel because they're structured data on
# the issue itself — no free-text parsing of the user-authored description.
# (Settings used to live in a `# Task Settings` description block; that block
# is no longer parsed, but its presence is still detected so the agent can be
# told to ignore it.) The prompt itself can't carry settings: it streams over
# stdin, so the wrapper can't inspect it without consuming it.
#
# Fail-open by design: any failure here skips task settings and is logged to
# claude.log; it must never abort the launch, since this runs on every turn of
# every agent and labels are softer, user-controlled input. Opt out with
# LWD_TASK_SETTINGS=0.
task_effort=""; task_model=""; task_provider=""; task_path=""
task_block_seen=false; task_labels_seen=false
_ts_log() {
  printf '%s task-settings: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" \
    >> "$_log_dir/claude.log" 2>/dev/null || true
}
case "${LWD_TASK_SETTINGS:-1}" in
  0|off|false|no) _ts_log "disabled via LWD_TASK_SETTINGS" ;;
  *)
    if ! command -v jq >/dev/null 2>&1; then
      _ts_log "jq not found; skipping task settings"
    elif [ -f "$WORKSPACE_DIR/CLAUDE.md" ]; then
      _ts_issue="$(grep -oE 'multica issue get [0-9a-fA-F-]{36}' "$WORKSPACE_DIR/CLAUDE.md" 2>/dev/null | head -1 | grep -oE '[0-9a-fA-F-]{36}' || true)"
      if [ -z "$_ts_issue" ]; then
        _ts_log "no issue id in $WORKSPACE_DIR/CLAUDE.md; skipping"
      else
        _ts_json="$("${MULTICA_BIN:-multica}" issue get "$_ts_issue" --output json 2>/dev/null || true)"
        if ! printf '%s' "$_ts_json" | jq -e '.id // empty' >/dev/null 2>&1; then
          _ts_log "could not read issue $_ts_issue; skipping"
        else
          # Legacy: record whether the description still carries a
          # `# Task Settings` block (no longer parsed) so we can still tell
          # the agent to ignore it.
          if printf '%s' "$_ts_json" | jq -r '.description // empty' 2>/dev/null \
               | grep -qiE '^[[:space:]]*#+[[:space:]]*task[[:space:]]+settings[[:space:]]*$'; then
            task_block_seen=true
          fi
          # Collect settings from labels named `key: value`. Split on the FIRST
          # colon (a model value like ollama's `qwen3:32b` keeps its colon),
          # lowercase/strip-spaces the key, trim the value, and drop one pair of
          # surrounding double quotes (forgiving a pasted `path: "/x y"`).
          # Unrecognised keys are other people's labels — ignored silently.
          # Collected before the assignee gate (and `task_labels_seen` tracked
          # independently of it) so a non-assignee agent can still be told the
          # labels aren't task content. Process substitution (not a pipeline)
          # keeps the assignments in this shell.
          _ts_lbl_effort=""; _ts_lbl_model=""; _ts_lbl_provider=""; _ts_lbl_path=""
          while IFS= read -r _lbl; do
            case "$_lbl" in *:*) ;; *) continue ;; esac
            _k="$(printf '%s' "${_lbl%%:*}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
            _v="${_lbl#*:}"
            _v="${_v#"${_v%%[![:space:]]*}"}"; _v="${_v%"${_v##*[![:space:]]}"}"
            case "$_v" in \"*\") _v="${_v#\"}"; _v="${_v%\"}" ;; esac
            case "$_k" in
              effort)   _ts_lbl_effort="$_v";   task_labels_seen=true ;;
              model)    _ts_lbl_model="$_v";    task_labels_seen=true ;;
              provider) _ts_lbl_provider="$_v"; task_labels_seen=true ;;
              path)     _ts_lbl_path="$_v";     task_labels_seen=true ;;
            esac
          done < <(printf '%s' "$_ts_json" | jq -r '.labels[]?.name // empty' 2>/dev/null || true)
          # Gate (runs only when settings labels are present — otherwise there
          # is nothing to apply): Task Settings describe how the task's
          # *assigned* work should be run, so honour them only when this very
          # agent is the one the work belongs to. Resolve our own agent id from
          # the "**You are: NAME** (ID: `…`)" line multica writes into the
          # workspace CLAUDE.md, then apply only if:
          #   - the issue is assigned to us (assignee_type=agent, id == ours), OR
          #   - the issue is assigned to a squad we lead (assignee_type=squad,
          #     squad leader_id == ours).
          # Any other case (a different agent, a squad we don't lead, a member,
          # or unassigned) leaves Task Settings off for this agent. Fail-safe:
          # if we can't resolve our id or the assignee, the gate stays closed
          # (settings not applied) — same safe direction as the rest of this
          # fail-open block.
          #
          # Primary: the "**You are: NAME** (ID: `<uuid>`)" line multica writes.
          # "You are: " is the only line carrying it (the issue/comment ids
          # elsewhere in the file do not), so select on that and pull the id out
          # by uuid regex rather than a fixed backtick column — a delimiter tweak
          # alone then can't break it.
          if [ "$task_labels_seen" = "true" ]; then
            _uuid_re='[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'
            _ts_agent="$(grep 'You are: ' "$WORKSPACE_DIR/CLAUDE.md" 2>/dev/null | grep -oE "$_uuid_re" | head -1 || true)"
            if [ -z "$_ts_agent" ]; then
              # Fallback (logged WARNING): the identity line is gone or reshaped.
              # Scan every uuid in the file and ask multica which ones resolve to
              # an agent — issue/comment ids do not, so they drop out. Apply only
              # when exactly one agent id remains; 0 or >1 is ambiguous, so stay
              # closed. Keeps us working if multica changes the line, while the
              # WARNING makes the drift visible in claude.log.
              _ts_n=0
              for _id in $(grep -oE "$_uuid_re" "$WORKSPACE_DIR/CLAUDE.md" 2>/dev/null | sort -u || true); do
                if "${MULTICA_BIN:-multica}" agent get "$_id" --output json 2>/dev/null \
                     | jq -e '.id // empty' >/dev/null 2>&1; then
                  _ts_agent="$_id"; _ts_n=$((_ts_n + 1))
                fi
              done
              if [ "$_ts_n" = 1 ]; then
                _ts_log "WARNING: 'You are:' identity line not found; fell back to the sole agent id ($_ts_agent) in CLAUDE.md — multica may have changed the line format"
              else
                _ts_agent=""
                if [ "$_ts_n" = 0 ]; then
                  _ts_log "WARNING: 'You are:' identity line not found and no agent id in CLAUDE.md; not applying"
                else
                  _ts_log "WARNING: 'You are:' identity line not found and $_ts_n agent ids in CLAUDE.md; ambiguous, not applying"
                fi
              fi
            fi
            _ts_atype="$(printf '%s' "$_ts_json" | jq -r '.assignee_type // empty' 2>/dev/null || true)"
            _ts_aid="$(printf '%s' "$_ts_json" | jq -r '.assignee_id // empty' 2>/dev/null || true)"
            _ts_apply=false
            if [ -z "$_ts_agent" ]; then
              _ts_log "could not resolve running agent id from CLAUDE.md; not applying"
            elif [ "$_ts_atype" = "agent" ] && [ -n "$_ts_aid" ] && [ "$_ts_aid" = "$_ts_agent" ]; then
              _ts_apply=true
            elif [ "$_ts_atype" = "squad" ] && [ -n "$_ts_aid" ]; then
              _ts_leader="$("${MULTICA_BIN:-multica}" squad get "$_ts_aid" --output json 2>/dev/null | jq -r '.leader_id // empty' 2>/dev/null || true)"
              if [ -n "$_ts_leader" ] && [ "$_ts_leader" = "$_ts_agent" ]; then
                _ts_apply=true
              else
                _ts_log "squad $_ts_aid not led by this agent ($_ts_agent); not applying"
              fi
            else
              _ts_log "issue assigned to ${_ts_atype:-nobody} (${_ts_aid:-none}), not this agent ($_ts_agent); not applying"
            fi
            if [ "$_ts_apply" = "true" ]; then
              task_effort="$_ts_lbl_effort"; task_model="$_ts_lbl_model"
              task_provider="$_ts_lbl_provider"; task_path="$_ts_lbl_path"
              # Validate task-sourced values; warn-and-ignore (never abort) on bad
              # input. ultracode is intentionally NOT an effort level — claude's
              # --effort only accepts low/medium/high/xhigh/max — so it lands here.
              if [ -n "$task_effort" ]; then
                case "$task_effort" in
                  low|medium|high|xhigh|max) ;;
                  *) _ts_log "ignoring invalid effort '$task_effort'"; task_effort="" ;;
                esac
              fi
              if [ -n "$task_provider" ] && [ "$task_provider" != "anthropic" ] \
                 && [ ! -f "$SCRIPT_DIR/claude-providers/$task_provider.sh" ]; then
                _ts_log "ignoring unknown provider '$task_provider'"; task_provider=""
              fi
              if [ -n "$task_path" ] && [ ! -d "$task_path" ]; then
                _ts_log "ignoring non-directory path '$task_path'"; task_path=""
              fi
              if [ -n "$task_effort$task_model$task_provider$task_path" ]; then
                _ts_log "applied effort='$task_effort' model='$task_model' provider='$task_provider' path='$task_path'"
              fi
            fi
          fi
        fi
      fi
    fi
    ;;
esac
unset _ts_issue _ts_json _ts_agent _ts_atype _ts_aid _ts_apply _ts_leader _uuid_re _id _ts_n _k _v _lbl _ts_lbl_effort _ts_lbl_model _ts_lbl_provider _ts_lbl_path

[ -n "$_lwd_model_override" ] && LWD_MODEL="$_lwd_model_override"
[ -n "$_lwd_allow_mcp_override" ] && LWD_ALLOW_MCP="$_lwd_allow_mcp_override"
# Resolve the effective provider: LWD_CLAUDE_PROVIDER (wrapper-specific) wins
# over LWD_PROVIDER (generic fallback); ambient (per-agent) wins over .env.
# Each layer picks the specific var when set, and the ambient layer as a whole
# beats the .env layer (a per-agent LWD_PROVIDER outranks a .env
# LWD_CLAUDE_PROVIDER). The result is folded into LWD_PROVIDER so the
# selection logic below is unchanged; the task overlay is applied after.
_eff_provider="${LWD_CLAUDE_PROVIDER:-${LWD_PROVIDER}}"
_amb_provider="${_lwd_claude_provider_override:-${_lwd_provider_override}}"
[ -n "$_amb_provider" ] && _eff_provider="$_amb_provider"
LWD_PROVIDER="$_eff_provider"
unset _lwd_provider_override _lwd_claude_provider_override _lwd_model_override _lwd_allow_mcp_override _eff_provider _amb_provider

# Task settings outrank per-agent (ambient) and global (.env) provider/model.
# Applied after the ambient re-apply above and before provider selection below,
# so a task-pinned provider sources the right file and a task model reaches it.
[ -n "$task_provider" ] && LWD_PROVIDER="$task_provider"
[ -n "$task_model" ] && LWD_MODEL="$task_model"

# Provider selection: LWD_PROVIDER here is the *resolved* effective name (task
# label > ambient LWD_CLAUDE_PROVIDER > ambient LWD_PROVIDER > .env values;
# see the resolution block above). It sources claude-providers/<name>.sh,
# which is expected to export ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN /
# model defaults to redirect claude at a non-Anthropic backend. Provider
# files may honor LWD_MODEL to pick a specific model.
# LWD_PROVIDER=anthropic is the native backend: load no provider env so claude
# uses its built-in Anthropic defaults.
# Fail loud on a missing file rather than silently falling back to Anthropic.
if [ -n "$LWD_PROVIDER" ] && [ "$LWD_PROVIDER" != "anthropic" ]; then
  provider_file="$SCRIPT_DIR/claude-providers/$LWD_PROVIDER.sh"
  if [ ! -f "$provider_file" ]; then
    echo "claude wrapper: LWD_PROVIDER='$LWD_PROVIDER' not found at $provider_file" >&2
    exit 1
  fi
  . "$provider_file"
fi

# Fallback model priority is ambient > provider > .env, so re-apply the ambient
# override after the provider file has had its say (a provider may set
# LWD_FALLBACK_MODEL to a model known to work with its backend).
[ -n "$_lwd_fallback_model_override" ] && LWD_FALLBACK_MODEL="$_lwd_fallback_model_override"
unset _lwd_fallback_model_override

# Effort level priority is ambient > provider > .env, same as the fallback
# model (a provider may pin an effort its backend tolerates). Re-apply the
# ambient override after the provider file has had its say.
[ -n "$_lwd_effort_override" ] && LWD_EFFORT="$_lwd_effort_override"
unset _lwd_effort_override

# Task-pinned effort outranks ambient and provider. Already validated above, so
# the loud check below only ever fires on operator-owned env/.env typos.
[ -n "$task_effort" ] && LWD_EFFORT="$task_effort"

# Validate LWD_EFFORT against the levels claude accepts. Fail loud on a typo
# rather than letting claude reject the flag mid-session (same philosophy as
# the loud failure on an unknown LWD_PROVIDER).
if [ -n "$LWD_EFFORT" ]; then
  case "$LWD_EFFORT" in
    low|medium|high|xhigh|max) ;;
    *)
      echo "claude wrapper: LWD_EFFORT='$LWD_EFFORT' invalid (expected: low, medium, high, xhigh, max)" >&2
      exit 1
      ;;
  esac
fi

working_dir=""

# Extract --working-directory <path> from anywhere in the argument list
new_args=()
skip_next=false
has_fallback_model=false
has_effort=false
has_model=false
for arg in "$@"; do
  if [ "$skip_next" = "true" ]; then
    working_dir="$arg"
    skip_next=false
    continue
  fi
  if [ "$arg" = "--working-directory" ]; then
    skip_next=true
    continue
  fi
  # Note a caller-provided --fallback-model so LWD_FALLBACK_MODEL doesn't
  # clobber it below. Also matches the --fallback-model=value form.
  if [ "$arg" = "--fallback-model" ] || [ "${arg%%=*}" = "--fallback-model" ]; then
    has_fallback_model=true
  fi
  # Note a caller-provided --effort so LWD_EFFORT doesn't clobber it below.
  # Also matches the --effort=value form.
  if [ "$arg" = "--effort" ] || [ "${arg%%=*}" = "--effort" ]; then
    has_effort=true
  fi
  # Note a caller-provided --model so LWD_MODEL doesn't clobber it below.
  # Also matches the --model=value form.
  if [ "$arg" = "--model" ] || [ "${arg%%=*}" = "--model" ]; then
    has_model=true
  fi
  # Drop multica's --strict-mcp-config when LWD_ALLOW_MCP=1 so the project's
  # own MCP servers (.claude/settings.json, user config) load. multica injects
  # this flag to sandbox SaaS agents; on a self-hosted setup the operator owns
  # the project and the sandboxing isn't wanted.
  if [ "$arg" = "--strict-mcp-config" ] && [ "$LWD_ALLOW_MCP" = "1" ]; then
    continue
  fi
  new_args+=("$arg")
done
set -- "${new_args[@]}"

# Fall back to the env var when the flag isn't provided
if [ -z "$working_dir" ] && [ ! -z "$LOCAL_WORKING_PATH" ]; then
  working_dir="$LOCAL_WORKING_PATH"
fi

# A task-pinned path outranks both --working-directory and LOCAL_WORKING_PATH
# (already checked to be a directory during task-settings parsing).
[ -n "$task_path" ] && working_dir="$task_path"

if [ ! -z "$working_dir" ] && [ -d "$working_dir" ]; then
  cd "$working_dir"
  # Build the appended system prompt: the workspace's CLAUDE.md (multica agent
  # instructions; --add-dir does NOT auto-discover it — verified empirically),
  # plus, when the issue carries settings labels or a legacy `# Task Settings`
  # block, a note telling the agent those are wrapper config and not part of
  # the task. Kept as ONE --append-system-prompt (claude's flag is not reliably
  # repeatable — a second one could clobber the first).
  _sys_addon=""
  [ -f "$WORKSPACE_DIR/CLAUDE.md" ] && _sys_addon="$(cat "$WORKSPACE_DIR/CLAUDE.md")"
  _ts_note=""
  if [ "$task_labels_seen" = "true" ]; then
    _ts_note="The issue carries labels of the form \`key: value\` (effort, model, provider, path). They are configuration for the multica-local-workdir claude wrapper, not part of the task to act on. Ignore them."
  fi
  if [ "$task_block_seen" = "true" ]; then
    _ts_blk_note="The issue description contains a \`# Task Settings\` block (key: value lines, possibly wrapped in an HTML comment). It is configuration for the multica-local-workdir claude wrapper (now superseded by settings labels), not part of the task to act on. Ignore it."
    if [ -n "$_ts_note" ]; then
      _ts_note="$_ts_note"$'\n'"$_ts_blk_note"
    else
      _ts_note="$_ts_blk_note"
    fi
  fi
  if [ -n "$_ts_note" ]; then
    if [ -n "$_sys_addon" ]; then
      _sys_addon="$_sys_addon"$'\n\n'"$_ts_note"
    else
      _sys_addon="$_ts_note"
    fi
  fi
  [ -n "$_sys_addon" ] && set -- --append-system-prompt "$_sys_addon" "$@"
fi

# Force a fallback model when LWD_FALLBACK_MODEL is set and the caller didn't
# already pass --fallback-model. Useful when switching providers whose models
# reject some parameters (thinking, …) — claude retries on the fallback.
if [ -n "$LWD_FALLBACK_MODEL" ] && [ "$has_fallback_model" = "false" ]; then
  set -- --fallback-model "$LWD_FALLBACK_MODEL" "$@"
fi

# Set the effort level when LWD_EFFORT is set and the caller didn't already
# pass --effort. In multica, env vars can be set per-agent, so a per-agent
# LWD_EFFORT is effectively dynamic effort classification: each agent runs at
# the effort its job warrants (e.g. max for orchestration/review, low for
# trivial chores) without the wrapper inspecting the streamed prompt.
if [ -n "$LWD_EFFORT" ] && [ "$has_effort" = "false" ]; then
  set -- --effort "$LWD_EFFORT" "$@"
fi

# Inject --model on the native Anthropic backend when LWD_MODEL is set and the
# caller didn't already pass --model. With a provider active, the provider file
# already consumes LWD_MODEL (sets ANTHROPIC_MODEL / ANTHROPIC_DEFAULT_*_MODEL),
# so injecting --model here would double-handle it — hence native-only. LWD_MODEL
# is the task > ambient > .env resolved value by this point.
if [ -n "$LWD_MODEL" ] && [ "$has_model" = "false" ] \
   && { [ -z "$LWD_PROVIDER" ] || [ "$LWD_PROVIDER" = "anthropic" ]; }; then
  set -- --model "$LWD_MODEL" "$@"
fi

exec "${CLAUDE_BIN:-claude}" "$@"
